{
  "name": "dynamoblobs",
  "version": "0.9.0",
  "type": "module",
  "description": "Lightweight, dependency-free generative SVG blobs that wobble, morph, and drift — delivered as a drop-in custom element.",
  "main": "dist/dynamoblobs.js",
  "module": "dist/dynamoblobs.js",
  "types": "dist/dynamoblobs.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --test",
    "build": "rollup -c",
    "prepare": "rollup -c",
    "prepublishOnly": "npm run build",
    "release": "npm publish",
    "release:dry": "npm run build && npm pack --dry-run",
    "docs:manifest": "mark-down build www/snippets --output www/snippets/snippets-index.json",
    "docs:manifest:watch": "mark-down watch www/snippets --output www/snippets/snippets-index.json",
    "docs:build": "npm run docs:manifest && mark-down compile-page www-src/index.html --manifest www/snippets/snippets-index.json --outDir www",
    "docs:watch": "chokidar \"www-src/index.html\" \"www/snippets/**/*.md\" -c \"npm run docs:build\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzebley/dynamoblobs.git"
  },
  "keywords": [
    "javascript",
    "svg",
    "html",
    "blob",
    "blobs",
    "generative",
    "custom-element",
    "web-components"
  ],
  "author": "Mark Zebley",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mzebley/dynamoblobs/issues"
  },
  "homepage": "https://dynamoblobs.markzebley.com/",
  "devDependencies": {
    "@mzebley/mark-down-cli": "^1.2.2",
    "@rollup/plugin-terser": "^0.4.4",
    "chokidar-cli": "^3.0.0",
    "jsdom": "^29.1.1",
    "rollup": "^3.29.4",
    "rollup-plugin-dts": "^6.1.1"
  },
  "dependencies": {
    "zebkit": "github:mzebley/zebkit"
  }
}
